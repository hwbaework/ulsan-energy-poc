// Cloudflare Workers(정적 에셋) 배포 설정 — `npm run deploy`
// 커스텀 도메인(ulsanenergypoc.pairwork.net)은 pairwork.net 존이 같은 Cloudflare 계정에 있어야 자동 연결된다.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ulsan-energy-poc",
  "compatibility_date": "2026-07-01",
  // 앞단 코드 — 화면 데이터 파일(.txt) 주소로 페이지가 통째 이동하면 원래 화면으로 돌려보낸다(worker/index.js 설명 참고)
  "main": "worker/index.js",
  "assets": {
    "directory": "./.next-build",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    // .txt 주소와 /api/*(기상특보)에만 앞단 코드가 돈다 — 나머지 파일은 지금처럼 바로 내려간다
    "run_worker_first": ["/*.txt", "/api/*"]
  },
  "routes": [{ "pattern": "ulsan-energy.pairworks.net", "custom_domain": true }]
}
